{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "target": "ES2017"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-desktop/types/**/*.ts",
    ".next-desktop/dev/types/**/*.ts",
    ".next-mcp-cache-hotfix/types/**/*.ts",
    ".next-mcp-cache-hotfix/dev/types/**/*.ts",
    ".next-omni-integration/types/**/*.ts",
    ".next-omni-integration/dev/types/**/*.ts",
    ".next-omni-qwen/types/**/*.ts",
    ".next-omni-qwen/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "demo",
    "test-results",
    "vendor",
    "computer-use/templates",
    "src-tauri/target",
    "src-tauri/resources"
  ]
}
